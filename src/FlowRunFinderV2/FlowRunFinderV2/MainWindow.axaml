<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlowRunFinderV2.MainWindow"
        Title="Flow Run Finder V2"
        Icon="/Assets/FlowRunFinderV2.ico"
        Width="1120"
        Height="760"
        MinWidth="860"
        MinHeight="560">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" Margin="18" RowSpacing="14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Text="Environment URL" VerticalAlignment="Center" />
      <TextBox x:Name="EnvironmentUrlTextBox"
               Grid.Column="1"
               Watermark="https://yourorg.crm.dynamics.com" />
      <Button x:Name="ConnectButton"
              Grid.Column="2"
              Content="Connect"
              Click="OnConnectClicked" />
      </Grid>

      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="Flow" VerticalAlignment="Center" />
        <ComboBox x:Name="FlowComboBox"
                  Grid.Column="1"
                  MinHeight="32"
                  SelectionChanged="OnFlowSelectionChanged" />
        <Button x:Name="RefreshRunsButton"
                Grid.Column="2"
                Content="Refresh Runs"
                IsEnabled="False"
                Click="OnRefreshRunsClicked" />
        <Button x:Name="TriggerColumnsButton"
                Grid.Column="3"
                Content="Trigger Columns"
                IsEnabled="False"
                Click="OnTriggerColumnsClicked" />
        <Popup x:Name="TriggerColumnsPopup"
               Grid.Column="3"
               PlacementTarget="{Binding ElementName=TriggerColumnsButton}"
               Placement="Bottom"
               IsLightDismissEnabled="True">
          <Border Width="320"
                  MaxHeight="380"
                  Padding="10"
                  CornerRadius="6"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <TextBlock Text="Trigger input columns"
                         FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TriggerColumnsItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Name}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Checked="OnTriggerColumnSelectionChanged"
                                Unchecked="OnTriggerColumnSelectionChanged" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Popup>
        </Grid>

        <Border Grid.Row="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              Padding="10"
              IsVisible="False"
              x:Name="DeviceCodePanel">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="6">
          <TextBlock x:Name="DeviceCodeMessageTextBlock"
                     Grid.ColumnSpan="3"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Row="1"
                     Text="URL"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceCodeUrlTextBlock"
                     Grid.Row="1"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button x:Name="CopyDeviceUrlButton"
                  Grid.Row="1"
                  Grid.Column="2"
                  Width="34"
                  Height="30"
                  Padding="7"
                  ToolTip.Tip="Copy login URL"
                  Click="OnCopyDeviceUrlClicked">
            <PathIcon Data="M8,2 L18,2 L18,14 L8,14 Z M5,6 L5,18 L15,18 L15,16 L7,16 L7,6 Z" />
          </Button>
          <TextBlock Grid.Row="2"
                     Text="Code"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceCodeTextBlock"
                     Grid.Row="2"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold" />
          <Button x:Name="CopyDeviceCodeButton"
                  Grid.Row="2"
                  Grid.Column="2"
                  Width="34"
                  Height="30"
                  Padding="7"
                  ToolTip.Tip="Copy device code"
                  Click="OnCopyDeviceCodeClicked">
            <PathIcon Data="M8,2 L18,2 L18,14 L8,14 Z M5,6 L5,18 L15,18 L15,16 L7,16 L7,6 Z" />
          </Button>
        </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                 Grid.Row="2"
                 Text="Not connected." />
      </Grid>

      <DataGrid x:Name="RunsDataGrid"
              Grid.Row="2"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Started" Binding="{Binding StartedOn}" Width="Auto" />
        <DataGridTextColumn Header="Ended" Binding="{Binding EndedOn}" Width="Auto" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
      </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Border x:Name="BusyOverlay"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="18"
            Padding="12"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar Width="86"
                     Height="6"
                     IsIndeterminate="True"
                     VerticalAlignment="Center" />
        <TextBlock x:Name="BusyTextBlock"
                   Text="Working..."
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
