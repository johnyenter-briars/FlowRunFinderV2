<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlowRunFinderV2.UI.Dialog.AdvancedSearchDialog"
        Title="Advanced Search"
        Width="1040"
        Height="760"
        MinWidth="840"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="16">
    <Border Padding="14"
            CornerRadius="8"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,*,Auto,Auto,*,Auto"
            RowSpacing="8"
            ColumnSpacing="10">
        <TextBlock Text="Start UTC"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   VerticalAlignment="Center" />
        <TextBox x:Name="StartUtcTextBox"
                 Grid.Column="1"
                 Watermark="2026-06-19T00:00:00Z" />
        <Button x:Name="StartUtcPickerButton"
                Grid.Column="2"
                Classes="icon"
                Content="📅"
                ToolTip.Tip="Pick start date and time"
                Click="OnStartUtcPickerClicked" />

        <TextBlock Text="End UTC"
                   Grid.Column="3"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   VerticalAlignment="Center" />
        <TextBox x:Name="EndUtcTextBox"
                 Grid.Column="4"
                 Watermark="2026-06-20T00:00:00Z" />
        <Button x:Name="EndUtcPickerButton"
                Grid.Column="5"
                Classes="icon"
                Content="📅"
                ToolTip.Tip="Pick end date and time"
                Click="OnEndUtcPickerClicked" />

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="1"
                   Grid.ColumnSpan="6"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <TextBlock Text="Filters"
                   FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <StackPanel x:Name="FilterBuilderPanel" />
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="Cancel"
              Click="OnCancelClicked" />
      <Button Content="Search"
              Classes="primary"
              Click="OnSearchClicked" />
    </StackPanel>
  </Grid>
</Window>
