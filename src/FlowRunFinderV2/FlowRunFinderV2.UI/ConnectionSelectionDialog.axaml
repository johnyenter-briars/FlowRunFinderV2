<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlowRunFinderV2.UI.ConnectionSelectionDialog"
        Title="Connections"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
    <TextBlock Text="Choose a connection"
               FontSize="18"
               FontWeight="SemiBold" />

    <ListBox x:Name="ConnectionsListBox"
             Grid.Row="1"
             DoubleTapped="OnOpenClicked" />

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button Content="New Connection"
              Click="OnNewClicked" />
      <TextBlock x:Name="ValidationTextBlock"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Button Grid.Column="2"
              Content="Cancel"
              Click="OnCancelClicked" />
      <Button Grid.Column="3"
              Content="Open"
              Click="OnOpenClicked" />
    </Grid>
  </Grid>
</Window>
